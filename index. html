<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--gold:#c5a15b;--black:#111;--white:#fff;--grey:#f5f5f5}
body{font-family:Arial,sans-serif;color:var(--black);background:#fff}
header{background:#111;color:white;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
.logo{font-size:25px;font-weight:900;letter-spacing:2px}
.logo span{color:var(--gold)}
nav{display:flex;gap:20px;flex-wrap:wrap}
nav a{color:white;text-decoration:none;font-size:13px;font-weight:bold}
nav a:hover{color:var(--gold)}
.cart{background:var(--gold);border:0;padding:11px 16px;border-radius:4px;font-weight:bold;cursor:pointer}
.hero{min-height:430px;background:linear-gradient(90deg,rgba(0,0,0,.8),rgba(0,0,0,.15)),url('https://images.unsplash.com/photo-1445205170230-053b83016050?w=1400') center/cover;display:flex;align-items:center;padding:50px 8%;color:white}
.hero-content{max-width:550px}
.hero small{color:var(--gold);letter-spacing:4px;font-weight:bold}
.hero h1{font-size:clamp(38px,7vw,68px);margin:20px 0;line-height:1.05}
.hero p{line-height:1.8;color:#eee;margin-bottom:25px}
.btn{display:inline-block;background:var(--gold);color:#111;padding:14px 25px;text-decoration:none;font-weight:bold;border:0;cursor:pointer;border-radius:3px}
.btn:hover{background:white}
section{padding:55px 6%}
.section-title{text-align:center;margin-bottom:30px}
.section-title small{color:#a47c36;letter-spacing:3px;font-weight:bold}
.section-title h2{font-size:30px;margin-top:10px}
.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.category{height:220px;position:relative;overflow:hidden;background:#ddd}
.category img{width:100%;height:100%;object-fit:cover;transition:.4s}
.category:hover img{transform:scale(1.08)}
.category a{position:absolute;bottom:15px;left:12px;background:#111;color:white;padding:12px 16px;text-decoration:none;font-weight:bold}
.filters{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:25px 0}
.filter{padding:10px 17px;background:white;border:1px solid #ccc;cursor:pointer;border-radius:25px}
.filter.active,.filter:hover{background:#111;color:white}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.product{border:1px solid #eee;background:white;overflow:hidden;transition:.2s}
.product:hover{box-shadow:0 5px 20px #ddd;transform:translateY(-3px)}
.product img{width:100%;height:230px;object-fit:cover;background:#eee}
.product-info{padding:15px}
.product-info small{color:#888}
.product-info h3{font-size:16px;margin:9px 0}
.price{font-weight:bold;color:#a47c36;font-size:18px;margin:10px 0}
.add{background:#111;color:white;border:0;padding:11px;width:100%;cursor:pointer;font-weight:bold}
.add:hover{background:var(--gold);color:#111}
.banner{background:#171717;color:white;text-align:center;padding:55px 15px}
.banner h2{font-size:32px;margin:12px}
.banner p{color:#ccc;margin-bottom:20px}
.about{text-align:center;background:#f7f7f7;line-height:1.9}
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;text-align:center}
.contact-card{padding:25px;background:#f5f5f5}
.contact-card h3{margin-bottom:10px}
.contact-card a{color:#98712e;text-decoration:none;overflow-wrap:anywhere}
footer{background:#111;color:white;text-align:center;padding:35px 15px;line-height:2}
footer strong{color:var(--gold)}
footer a{color:white;text-decoration:none}
#cart-panel{display:none;background:#f5f5f5;padding:25px;margin:20px 6%;border:1px solid #ddd}
#cart-panel h2{margin-bottom:15px}
.cart-line{padding:10px 0;border-bottom:1px solid #ddd}
#cart-panel button{margin:8px 5px 0 0;padding:10px;cursor:pointer}
.empty{color:#777}
@media(max-width:850px){
.categories{grid-template-columns:repeat(2,1fr)}
.products{grid-template-columns:repeat(2,1fr)}
header{justify-content:center}
nav{justify-content:center}
}
@media(max-width:480px){
.logo{font-size:22px}
nav{gap:12px}
nav a{font-size:12px}
.hero{min-height:380px;padding:35px 6%}
.hero h1{font-size:42px}
section{padding:40px 4%}
.products{gap:10px}
.product img{height:175px}
.product-info{padding:10px}
.product-info h3{font-size:14px}
.contact-grid{grid-template-columns:1fr}
}
</style>
