<script>
let cart=[];
function addToCart(name,price){
cart.push({name,price});
updateCart();
alert(name+" added to your cart!");
}
function updateCart(){
document.getElementById('count').textContent=cart.length;
document.getElementById('total').textContent=cart.reduce((sum,item)=>sum+item.price,0).toLocaleString('en-KE');
let box=document.getElementById('cart-items');
if(cart.length===0){
box.innerHTML='<p class="empty">Your cart is empty.</p>';
return;
}
box.innerHTML=cart.map((item,index)=>
'<div class="cart-line">'+item.name+' - KSh '+item.price.toLocaleString('en-KE')+
' <button onclick="removeItem('+index+')">Remove</button></div>'
).join('');
}
function removeItem(index){
cart.splice(index,1);
updateCart();
}
function clearCart(){
cart=[];
updateCart();
}
function toggleCart(){
let panel=document.getElementById('cart-panel');
panel.style.display=panel.style.display==='block'?'none':'block';
panel.scrollIntoView({behavior:'smooth'});
}
function filterProducts(category,button){
document.querySelectorAll('.product').forEach(product=>{
product.style.display=(category==='All'||product.dataset.category===category)?'':'none';
});
document.querySelectorAll('.filter').forEach(btn=>btn.classList.remove('active'));
if(button)button.classList.add('active');
}
function checkout(){
if(cart.length===0){alert('Your cart is empty!');return;}
let message='Hello Arasa Digital, I would like to order:%0A';
cart.forEach(item=>{message+=encodeURIComponent(item.name+' - KSh '+item.price)+'%0A';});
message+='Total: KSh '+cart.reduce((sum,item)=>sum+item.price,0);
window.location.href='mailto:mosesarasa3@gmail.com?subject=Fashion Order&body='+message;
}
</script>
